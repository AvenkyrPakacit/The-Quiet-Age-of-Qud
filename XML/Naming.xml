	<namestyle Name="Eldimor Hero" Base="Eldimor">
      <scopes>
        <scope Name="Main1" Special="Hero" Faction="Eldimor" Priority="200" Combine="false" />
        <scope Name="Main2" Special="Hero" Faction="TQAQ_Temperate_Clans" Priority="200" Combine="false" />
		<scope Name="Main3" Special="Hero" Faction="TQAQ_Arid_Clans" Priority="200" Combine="false" />
		<scope Name="Main4" Special="Hero" Faction="TQAQ_Artic_Clans" Priority="200" Combine="false" />
		<scope Name="Main5" Special="Hero" Faction="TQAQ_Alpine_Clans" Priority="200" Combine="false" />
		<scope Name="Main5" Special="Hero" Faction="Sivlao" Priority="200" Combine="false" />
      </scopes>
      <templates>
        <template Name="*Name*" />
      </templates>
    </namestyle>

	<namestyle Name="Eldimor Hero Epithet">
