		<scope Name="Main1" Type="Epithet" Special="Hero" Faction="TQAQ_Temperate_Clans" Priority="200" Combine="false" />
		<scope Name="Main2" Type="Epithet" Special="Hero" Faction="TQAQ_Arid_Clans" Priority="200" Combine="false" />
